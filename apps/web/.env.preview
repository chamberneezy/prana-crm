# The public preview on GitHub Pages (npm run build:preview -w @prana/web):
# real sign-in through the Firebase project "Prana", with the API still running inside the
# browser on sample data. There is no server yet, so each browser keeps its own data.
VITE_DEMO=true
VITE_AUTH=firebase
VITE_AUTH_PROVIDERS=google,password

# Public identifiers of the Firebase web app (they are not secrets; access is decided by sign-in).
VITE_FIREBASE_API_KEY=AIzaSyAYKhGKg4AtF4eWXpGZDFptXsxCEgPd6d4
VITE_FIREBASE_AUTH_DOMAIN=prana-studio-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=prana-studio-crm
VITE_FIREBASE_APP_ID=1:417668673455:web:24ae509cebfea1b4f1895a

# Who may come in, as SHA-256 of the lower-cased e-mail (comma-separated), so no address is published.
# This check runs in the browser and only keeps the preview tidy; real access control is the API's staff list.
VITE_OWNER_HASHES=c3e1f241479cc7a5ed51c21c2391f0b4aafdd94bd45886265ff3f84f3d0577ad,a0110f14d6aba9b41d5aed1f17b54c0abfc013f6d7a519bb4f13a0a9f2e8c2a7
