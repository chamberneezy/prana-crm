# Production values come from the Firebase console (Project settings → Your apps → Web app).
# Copy to .env.production.local; that file is never committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=prana-crm
VITE_FIREBASE_APP_ID=
# Leave empty in production. Set to the emulator's address to sign in locally.
VITE_FIREBASE_AUTH_EMULATOR_URL=
