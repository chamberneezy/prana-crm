{
  "name": "prana-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prana/web",
    "build": "npm run build -w @prana/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:all": "node scripts/dev.mjs",
    "e2e": "playwright test",
    "build:demo": "npm run build:demo -w @prana/web",
    "e2e:demo": "playwright test -c playwright.demo.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.33.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
