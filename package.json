{
  "name": "prana-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prana/web",
    "build": "npm run build -w @prana/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
